    {
        "id": "fn.ram",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Parse RAM",
        "func": "const text = (msg.payload || '').toString();\nconst lines = text.split('\\n');\nconst get = (k) => {\n    const m = lines.find(l => l.startsWith(k + ':'));\n    return m ? parseInt(m.split(/\\s+/)[1]) : 0;\n};\nconst total = get('MemTotal');\nconst available = get('MemAvailable');\nconst used = total - available;\nconst pct = total > 0 ? (used / total) * 100 : 0;\nmsg.payload = {\n    used:      Math.round(used / 1024),\n    total:     Math.round(total / 1024),\n    available: Math.round(available / 1024),\n    pct:       parseFloat(pct.toFixed(1))\n};\nmsg.topic = 'RAM';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 280,
        "wires": [
            [
                "gauge.ram",
                "chart.ram",
                "ui.text.ram"
            ]
        ]
    },
    {
        "id": "fn.ram.err",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Error fallback",
        "func": "msg.payload = {used:0,total:0,available:0,pct:0};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 320,
        "wires": [
            [
                "gauge.ram",
