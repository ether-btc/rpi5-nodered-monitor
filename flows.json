        "id": "fn.load",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Parse loadavg",
        "func": "const parts = (msg.payload || '').toString().trim().split(/\\s+/);\nmsg.payload = {\n    \"1m\":  parseFloat(parts[0]) || 0,\n    \"5m\":  parseFloat(parts[1]) || 0,\n    \"15m\": parseFloat(parts[2]) || 0\n};\nmsg.topic = 'Load Average';\nreturn msg;",
