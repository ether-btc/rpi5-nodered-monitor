    {
        "id": "exec.disk",
        "type": "exec",
        "z": "tab.rpi5",
        "command": "df -BG /hostroot /hostroot/mnt/data 2>/dev/null",
        "addpay": false,
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Read df + uptime",
        "x": 370,
        "y": 420,
        "wires": [
            [
                "fn.disk"
            ],
            [
                "fn.disk.err"
            ]
        ]
    },
    {
        "id": "fn.disk",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Parse disk & uptime",
        "func": "const text = (msg.payload || '').toString().trim();\nconst lines = text.split('\\n').map(l => l.trim().split(/\\s+/)).filter(l => l.length >= 6);\n// df inside the container may report bind mounts as the container's own\n// mountpoint (e.g. /hostroot shows as /data because the overlay lives on\n// the same block device). Identify disks by filesystem device, not by col 5.\n// Expected hosts on RPi5 Debian: root SD = /dev/mmcblk0p2, USB = /dev/sda1.\nconst findDev = (dev) => lines.find(p => p[0] === dev) || null;\nconst root = findDev('/dev/mmcblk0p2') || lines[0] || null;\nconst usbd = findDev('/dev/sda1')      || null;\nconst pct = (p) => p ? parseInt((p[4] || '0%').replace('%','')) : 0;\nconst gb  = (p, i) => p ? parseInt((p[i] || '0G').replace('G','')) : 0;\nlet upStr = (typeof msg.uptime === 'string') ? msg.uptime : 'n/a';\nmsg.payload = {\n    root_used_pct: pct(root), root_used_gb: gb(root, 2), root_total_gb: gb(root, 1),\n    usb_used_pct:  pct(usbd),  usb_used_gb:  gb(usbd, 2),  usb_total_gb:  gb(usbd, 1),\n    uptime: upStr\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 400,
        "wires": [
            [
                "gauge.disk.root",
                "gauge.disk.usb",
                "ui.text.disk",
                "ui.text.uptime"
            ]
        ]
    },
    {
        "id": "fn.disk.err",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Error fallback",
        "func": "msg.payload = {root_used_pct:0,root_used_gb:0,root_total_gb:0,usb_used_pct:0,usb_used_gb:0,usb_total_gb:0,uptime:'n/a'};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 440,
        "wires": [
            [
                "gauge.disk.root",
                "gauge.disk.usb",
                "ui.text.disk",
                "ui.text.uptime"
            ]
        ]
    },
