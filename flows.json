    {
        "id": "exec.temp",
        "type": "exec",
        "z": "tab.rpi5",
        "command": "cat /sys/class/thermal/thermal_zone0/temp",
        "addpay": false,
        "append": "",
        "useSpawn": "false",
        "timer": "",
        "winHide": false,
        "oldrc": false,
        "name": "Read /sys/class/thermal",
        "x": 370,
        "y": 80,
        "wires": [
            [
                "fn.temp"
            ],
            [
                "fn.temp.err"
            ]
        ]
    },
    {
        "id": "fn.temp",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Parse to °C",
        "func": "const raw = (msg.payload || '').toString().trim();\nconst celsius = parseFloat((parseInt(raw) / 1000).toFixed(1));\nmsg.payload = isNaN(celsius) ? -1 : celsius;\nmsg.topic = 'CPU Temp';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 60,
        "wires": [
            [
                "gauge.temp",
                "chart.temp",
                "ui.text.temp"
            ]
        ]
    },
    {
        "id": "fn.temp.err",
        "type": "function",
        "z": "tab.rpi5",
        "name": "Error fallback",
        "func": "msg.payload = -1;\nmsg.topic = 'CPU Temp (error)';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            [
                "gauge.temp",
                "chart.temp",
