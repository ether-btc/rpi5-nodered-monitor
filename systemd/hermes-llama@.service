[Unit]
Description=Hermes llama.cpp inference server (port %i)
Documentation=https://hermes-agent.nousresearch.com/docs
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/hermes-pi/.hermes/scripts/llama-server-wrapper.sh %i
WorkingDirectory=/home/hermes-pi
Restart=always
RestartSec=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
# Bound to loopback — no external exposure by accident.
# OOM before swap fill is preferable to silent partial crashes.
OOMPolicy=stop
OOMScoreAdjust=-100

[Install]
WantedBy=default.target
